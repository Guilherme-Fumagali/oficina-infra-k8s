# Modelo. O Secret real é gerado pelo Terraform a partir dos parâmetros do SSM —
# nunca versionado com valores preenchidos.
apiVersion: v1
kind: Secret
metadata:
  name: oficina-api-secret
  namespace: oficina
type: Opaque
stringData:
  DB_USER: "oficina"
  DB_PASS: "trocar"
  # Mesmo segredo que a Lambda usa para assinar (ADR-009).
  JWT_SECRET: "trocar-por-valor-de-no-minimo-32-bytes"
  NEW_RELIC_LICENSE_KEY: "trocar"
